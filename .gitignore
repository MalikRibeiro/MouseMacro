# pyenv
#   .python-version

# pipenv
#   De acordo com a documentação do pipenv, é recomendado incluir Pipfile.lock no controle de versão.
#   No entanto, em caso de # colaboração, se você quiser garantir que todos usem a mesma versão, descomente a linha abaixo.
#   Pipfile.lock

# poetry
#   Similar ao Pipfile.lock, Poetry também cria um arquivo de lock.
#   poetry.lock

# pdm
#   Similar ao Pipfile, PDM também cria um arquivo de lock.
#   pdm.lock

# PEP 582; usado por padrão pelo pdm para armazenar dependências do projeto
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

